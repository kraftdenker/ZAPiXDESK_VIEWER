# ==========================================================================
# ZAPiXDeskViewer — .gitignore
# Python + PySide6 (Qt) + tkinter
# ==========================================================================

# --- Python bytecode & caches ---------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# --- Virtual environments -------------------------------------------------
# The launcher scripts (run_qt.sh / run_qt.bat) create and use this venv.
# Never commit it: it is large, platform-specific and reproducible from
# requirements.txt.
venv/
.venv/
env/
ENV/

# --- pip / packaging ------------------------------------------------------
# Wheels, sdists and build artifacts produced by `pip` / PyInstaller.
build/
dist/
*.egg-info/
*.egg
wheels/
pip-wheel-metadata/
.installed.cfg

# --- Test / quality tool caches -------------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.cache/

# --- Application runtime files --------------------------------------------
# The viewer writes a log next to the script (see ZAPiXDeskViewer.py LOG_PATH)
# and may create a temporary extraction cache for the export databases.
*.log
zapixdeskviewer.log
*.log.*
zapixdesk_cache/

# --- Large export data (user content) -------------------------------------
# Never commit ZAPiXDESK chat exports or their checksums: they are large
# and contain personal data. (They live outside this folder by default, but
# guard against accidentally adding them here.)
*.zip
*.md5.txt
exports/

# --- PyInstaller build output ---------------------------------------------
# (PyInstaller is optional — see the "Build an executable" section.)
*.manifest
*.spec

# --- Editors / IDEs / OS junk ---------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Jupyter / notebooks (if you add any) ---------------------------------
.ipynb_checkpoints/
